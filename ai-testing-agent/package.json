{
  "name": "ai-testing-agent",
  "version": "1.0.0",
  "description": "AI Testing Agent para UMSS Market",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:enhanced": "node src/index.enhanced.js",
    "mcp": "node src/agents/postman.agent.enhanced.js",
